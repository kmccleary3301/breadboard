{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/contracts/public/schemas/bb.payload.product_session.lifecycle.v1.schema.json",
  "title": "BreadBoard Product Session Lifecycle Payload V1",
  "oneOf": [
    { "$ref": "#/$defs/sessionStarted" },
    { "$ref": "#/$defs/inputAccepted" },
    { "$ref": "#/$defs/approvalRequested" },
    { "$ref": "#/$defs/approvalResolved" },
    { "$ref": "#/$defs/sessionReconfigured" },
    { "$ref": "#/$defs/sessionAdoptionCommitted" },
    { "$ref": "#/$defs/sessionPaused" },
    { "$ref": "#/$defs/sessionResumed" },
    { "$ref": "#/$defs/sessionCompleted" },
    { "$ref": "#/$defs/sessionFailed" },
    { "$ref": "#/$defs/sessionCanceled" }
  ],
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_session_id", "root_session_id", "parent_work_item_id", "child_work_item_id"],
      "properties": {
        "parent_session_id": { "type": "string", "minLength": 1 },
        "root_session_id": { "type": "string", "minLength": 1 },
        "parent_work_item_id": { "type": "string", "minLength": 1 },
        "child_work_item_id": { "type": "string", "minLength": 1 }
      }
    },
    "moduleInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "body", "final"],
      "properties": {
        "schema_id": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "final": { "type": "boolean" }
      }
    },
    "sessionStarted": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effective_lock_hash", "task_hash"],
          "properties": {
            "effective_lock_hash": { "$ref": "#/$defs/sha256" },
            "task_hash": { "$ref": "#/$defs/sha256" },
            "lineage": { "$ref": "#/$defs/lineage" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effective_lock_hash",
            "task_hash",
            "module_input",
            "module_input_sequence"
          ],
          "properties": {
            "effective_lock_hash": { "$ref": "#/$defs/sha256" },
            "task_hash": { "$ref": "#/$defs/sha256" },
            "module_input": { "$ref": "#/$defs/moduleInput" },
            "module_input_sequence": { "type": "integer", "minimum": 0 },
            "lineage": { "$ref": "#/$defs/lineage" }
          }
        }
      ]
    },
    "inputAccepted": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_hash", "attachments"],
          "properties": {
            "content_hash": { "$ref": "#/$defs/sha256" },
            "attachments": { "$ref": "#/$defs/attachments" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["module_input", "module_input_sequence", "attachments"],
          "properties": {
            "module_input": { "$ref": "#/$defs/moduleInput" },
            "module_input_sequence": { "type": "integer", "minimum": 0 },
            "attachments": { "$ref": "#/$defs/attachments" }
          }
        }
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "size_bytes", "media_type"],
        "properties": {
          "digest": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approvalRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "operation"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 }
      }
    },
    "approvalResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "decision"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["allow", "deny", "once", "always", "reject"] }
      }
    },
    "sessionReconfigured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_lock_hash", "reason"],
      "properties": {
        "effective_lock_hash": { "$ref": "#/$defs/sha256" },
        "reason": { "type": "string" }
      }
    },
    "sessionAdoptionCommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_id",
        "checkpoint_id",
        "source_generation_id",
        "source_module_id",
        "source_instance_id",
        "source_work_id",
        "source_attempt_id",
        "source_schema_id",
        "source_body_sha256",
        "source_frontier",
        "target_generation_id",
        "effective_lock_hash",
        "reason",
        "migration"
      ],
      "properties": {
        "adoption_id": { "type": "string", "minLength": 1 },
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "source_generation_id": { "$ref": "#/$defs/sha256" },
        "source_module_id": { "type": "string", "minLength": 1 },
        "source_instance_id": { "type": "string", "minLength": 1 },
        "source_work_id": { "type": "string", "minLength": 1 },
        "source_attempt_id": { "type": "string", "minLength": 1 },
        "source_schema_id": { "type": "string", "minLength": 1 },
        "source_body_sha256": { "$ref": "#/$defs/sha256" },
        "source_frontier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_sequence",
            "generation_id",
            "typed_input_sequence",
            "output_sequence",
            "compaction_index"
          ],
          "properties": {
            "event_sequence": { "type": "integer", "minimum": 0 },
            "generation_id": { "$ref": "#/$defs/sha256" },
            "typed_input_sequence": { "type": "integer", "minimum": 0 },
            "output_sequence": { "type": "integer", "minimum": 0 },
            "compaction_index": { "type": "integer", "minimum": 0 }
          }
        },
        "target_generation_id": { "$ref": "#/$defs/sha256" },
        "effective_lock_hash": { "$ref": "#/$defs/sha256" },
        "reason": { "type": "string" },
        "request_id": { "type": "string", "minLength": 1 },
        "migration": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "disposition",
              "source_schema_id",
              "target_schema_id",
              "reason"
            ],
            "properties": {
              "binding": { "type": "string", "minLength": 1 },
              "disposition": { "enum": ["compatible", "migrate"] },
              "source_schema_id": { "type": "string", "minLength": 1 },
              "target_schema_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "sessionPaused": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": { "reason": { "type": "string" } }
    },
    "sessionResumed": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "sessionCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "summary"],
      "properties": {
        "outcome": { "const": "completed" },
        "summary": { "type": "string" },
        "lineage": { "$ref": "#/$defs/lineage" }
      }
    },
    "sessionFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "error", "detail"],
      "properties": {
        "outcome": { "const": "failed" },
        "error": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "lineage": { "$ref": "#/$defs/lineage" }
      }
    },
    "sessionCanceled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason"],
      "properties": {
        "outcome": { "const": "canceled" },
        "reason": { "type": "string" },
        "lineage": { "$ref": "#/$defs/lineage" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
