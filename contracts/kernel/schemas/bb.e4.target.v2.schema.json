{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.dev/contracts/kernel/schemas/bb.e4.target.v2.schema.json",
  "title": "BreadBoard E4 target descriptor V2",
  "description": "Closed descriptor for a byte-verified E4 target package. Runtime meaning is declared by the referenced target configuration; this descriptor does not grant executable capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_id",
    "family",
    "version",
    "execution",
    "overlay",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "bb.e4.target.v2"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@/-]*$"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "overlay": {
      "$ref": "#/$defs/overlay"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_asset",
        "tool_surface_asset"
      ],
      "oneOf": [
        {"required": ["system_prompt_asset"]},
        {"required": ["system_prompt_source"]}
      ],
      "properties": {
        "config_asset": {
          "$ref": "#/$defs/relative_path"
        },
        "system_prompt_asset": {
          "$ref": "#/$defs/relative_path"
        },
        "system_prompt_source": {
          "$ref": "#/$defs/identifier"
        },
        "tool_surface_asset": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay_id",
        "argv",
        "settings"
      ],
      "properties": {
        "overlay_id": {
          "$ref": "#/$defs/identifier"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/identifier"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
