{
  "schema_version": "bb.e4.omp-inputs.v1",
  "closed": true,
  "tools": {
    "read": {"required": ["path"], "optional": ["line", "range", "raw", "tail", "conflicts"]},
    "bash": {"required": ["command"], "optional": ["env", "timeout", "cwd"]},
    "edit": {"required": ["input"], "optional": []},
    "write": {"required": ["path", "content"], "optional": []}
  },
  "excluded_fields": ["pty", "async", "url", "ssh", "archive", "sqlite", "image", "video", "pdf", "internal-resource"],
  "edit": {"variant": "hashline", "fuzzyMatch": true, "fuzzyThreshold": 0.95, "enforceSeenLines": true, "blockAutoGenerated": true, "autoRepair": false},
  "bash": {"timeout_default_seconds": 300, "timeout_max_seconds": 30, "timeout_zero_disables": true, "wall_time_notice": "Wall time: {seconds:.2f} seconds"}
}
