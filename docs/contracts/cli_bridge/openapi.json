{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HarnessCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "directory": {
            "default": ".",
            "title": "Directory",
            "type": "string"
          }
        },
        "title": "HarnessCreateRequest",
        "type": "object"
      },
      "HarnessUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "definition": {
            "additionalProperties": true,
            "title": "Definition",
            "type": "object"
          }
        },
        "required": [
          "definition"
        ],
        "title": "HarnessUpdateRequest",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "title": "Error Code",
            "type": "string"
          },
          "failed_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failed Stage"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "next_actions": {
            "items": {
              "type": "string"
            },
            "title": "Next Actions",
            "type": "array"
          },
          "record_refs": {
            "items": {
              "type": "string"
            },
            "title": "Record Refs",
            "type": "array"
          },
          "schema_version": {
            "const": "bb.problem.v1",
            "default": "bb.problem.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "message"
        ],
        "title": "Problem",
        "type": "object"
      },
      "PublicResult": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "items": {
              "type": "string"
            },
            "title": "Command",
            "type": "array"
          },
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_code": {
            "title": "Exit Code",
            "type": "integer"
          },
          "hashes": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Hashes",
            "type": "object"
          },
          "next_actions": {
            "items": {
              "type": "string"
            },
            "title": "Next Actions",
            "type": "array"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "record_refs": {
            "items": {
              "type": "string"
            },
            "title": "Record Refs",
            "type": "array"
          },
          "schema_version": {
            "const": "bb.cli.result.v1",
            "default": "bb.cli.result.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "stage_outcomes": {
            "items": {
              "$ref": "#/components/schemas/StageOutcome"
            },
            "title": "Stage Outcomes",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status",
          "command",
          "record_refs",
          "hashes",
          "stage_outcomes",
          "warnings",
          "next_actions",
          "error",
          "exit_code",
          "data"
        ],
        "title": "PublicResult",
        "type": "object"
      },
      "SessionApprovalRequest": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "allow",
              "deny",
              "once",
              "always",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "decision"
        ],
        "title": "SessionApprovalRequest",
        "type": "object"
      },
      "SessionCancelRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "default": "operator request",
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "SessionCancelRequest",
        "type": "object"
      },
      "SessionInputRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "SessionInputRequest",
        "type": "object"
      },
      "SessionStartRequest": {
        "additionalProperties": false,
        "properties": {
          "lock_id": {
            "minLength": 1,
            "title": "Lock Id",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "task": {
            "minLength": 1,
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "lock_id",
          "task"
        ],
        "title": "SessionStartRequest",
        "type": "object"
      },
      "StageOutcome": {
        "additionalProperties": false,
        "properties": {
          "next_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Action"
          },
          "report_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Ref"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "status"
        ],
        "title": "StageOutcome",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
