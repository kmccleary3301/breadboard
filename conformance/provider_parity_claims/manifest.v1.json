      "id": "codex-alias",
      "summary": "BreadBoard's canonical provider id is codex; the pinned OMP provider id is openai-codex."
    },
    {
      "f6_rows": [],
      "id": "configured-only-models",
      "summary": "BreadBoard admits explicit configured models only; OMP may discover models dynamically and change defaults."
    },
    {
      "f6_rows": [],
      "id": "codex-transport",
      "summary": "BreadBoard uses the Codex app-server runtime; OMP's oracle exercises its Responses transport. Only normalized product-visible semantics are compared."
    },
    {
      "f6_rows": [],
      "id": "auth-mechanics",
      "summary": "BreadBoard owns a durable broker, precedence, affinity, refresh, revoke, and tombstones; OMP owns different credential storage and selection mechanics."
    },
    {
      "f6_rows": [],
      "id": "subscription-material-policy",
      "summary": "Broker API-key/OAuth schemes do not authorize direct consumer-subscription material; scheme-specific policy manifests remain authoritative."
    },
    {
      "f6_rows": [],
      "id": "exchange-ir",
