{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb.provider_differential_manifest.v1",
  "title": "BreadBoard provider differential evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "matrix_id", "created_at", "oracle_identity", "breadboard_commit", "breadboard_tree", "row_count", "rows"],
  "properties": {
    "schema_version": {"const": "bb.provider_differential_manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "matrix_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "oracle_identity": {"$ref": "#/$defs/oracle_identity"},
    "breadboard_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "breadboard_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "row_count": {"const": 45},
    "rows": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "oracle_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "commit", "tree"],
      "properties": {
        "repository": {"const": "can1357/oh-my-pi"},
        "tag": {"const": "v18.0.1"},
        "commit": {"const": "6c1209842323bb4713f127ac303c97fd043d585c"},
        "tree": {"const": "67a19f0d45a71af8c3d9ae83562ffb1fcb579d61"}
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "source", "sha256"],
      "properties": {
        "artifact_id": {"enum": ["artifact.wheel_provider_catalog_auth_role", "artifact.sdk_local_responses", "artifact.installed_end_to_end_trace"]},
        "source": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id", "claim", "provider", "seam", "comparator", "oracle_identity",
        "oracle_source_blobs", "oracle_runner", "oracle_input_sha256", "oracle_output_sha256",
        "breadboard_commit", "breadboard_tree", "evidence", "classification",
        "verification_toolchain", "verified_at"
      ],
      "properties": {
        "row_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "seam": {"type": "string", "minLength": 1},
        "comparator": {"type": "string", "minLength": 1},
        "oracle_identity": {"$ref": "#/$defs/oracle_identity"},
        "oracle_source_blobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blob"}},
        "oracle_runner": {"type": "string", "minLength": 1},
        "oracle_input_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_output_sha256": {"$ref": "#/$defs/sha256"},
        "breadboard_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "breadboard_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blob"}},
        "classification": {"enum": ["match", "intentional_divergence", "BreadBoard_defect", "unverified"]},
        "divergence_ref": {"type": "string", "minLength": 1},
        "artifact_provenance": {"$ref": "#/$defs/artifact_provenance"},
        "verification_toolchain": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"row_id": {"pattern": "^artifact\\."}}},
          "then": {"required": ["artifact_provenance"]}
        },
        {
          "if": {"properties": {"row_id": {"pattern": "^(?!artifact\\.).+"}}},
          "then": {"not": {"required": ["artifact_provenance"]}}
        }
      ]
    }
  }
}
